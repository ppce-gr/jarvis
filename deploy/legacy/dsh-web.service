[Unit]
Description=DSH web + puente LAN + redirección con token (TEMPORAL)
Documentation=file:/home/jarvis/jarvis/deploy/README.md
After=network-online.target
Wants=network-online.target

# ------------------------------------------------------------
#  TEMPORAL. Este servicio existe sólo mientras la conversación
#  conceptual siga viviendo en `dsh web`.
#
#  Cuando el chat esté dentro de Jarvis, se apaga y se retiran con él:
#    systemctl disable --now dsh-web
#  con lo que desaparecen los puertos 3080, 3085 y 8080, y se
#  libera la mayor parte de la memoria del sistema.
#
#  NOTA: esta unidad SUSTITUYE a init_deep_deep_seek.service.
#  No las tengas activas a la vez o chocarán por los puertos.
# ------------------------------------------------------------

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis
Environment=HOME=/home/jarvis
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DSH_BIN=/usr/local/bin/dsh

ExecStart=/home/jarvis/arrancar-dsh.sh

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dsh-web

[Install]
WantedBy=multi-user.target
