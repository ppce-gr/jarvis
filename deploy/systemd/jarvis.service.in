[Unit]
Description=Jarvis · Centro de Mando (interfaz web de ideas y orquestación)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Rutas y usuario: los rellena `deploy/instalar.sh` desde deploy/jarvis.conf.
# No los edites aquí: edita la configuración y vuelve a instalar.
User=@JARVIS_USER@
Group=@JARVIS_GROUP@
WorkingDirectory=@JARVIS_CODE_DIR@
Environment=HOME=@JARVIS_HOME@
# La memoria vive en un repositorio aparte, fuera del codigo.
Environment=JARVIS_BRAIN_DIR=@JARVIS_BRAIN_DIR@
Environment=JARVIS_CODE_DIR=@JARVIS_CODE_DIR@
Environment=JARVIS_UPDATE_STATE=@JARVIS_UPDATE_STATE@
Environment=JARVIS_UPDATE_FLAG=@JARVIS_UPDATE_FLAG@

# El CLI dsh vive aquí tras 'npm install -g @deepseek-ai/dsh@<version fijada>'.
Environment=JARVIS_DSH_BIN=@JARVIS_DSH_BIN@
Environment=JARVIS_DSH_PROFILE=@JARVIS_DSH_PROFILE@
Environment=JARVIS_PORT=@JARVIS_PORT@
Environment=JARVIS_HOST=@JARVIS_HOST@
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# --- Chat conversacional (ACP, un proceso para todos los proyectos) ---
# Perfil aparte del de orquestación: el chat necesita un proceso vivo con
# memoria, la orquestación necesita uno que muera al terminar.
# ACP aporta cancelacion real, reanudacion de la memoria y streaming por deltas.
Environment=JARVIS_CHAT_PROTOCOL=@JARVIS_CHAT_PROTOCOL@
Environment=JARVIS_CHAT_PROFILE=@JARVIS_CHAT_PROFILE@
Environment=JARVIS_CHAT_PROVIDER=@JARVIS_CHAT_PROVIDER@
Environment=JARVIS_CHAT_MODEL=@JARVIS_CHAT_MODEL@
Environment=JARVIS_CHAT_EFFORT=@JARVIS_CHAT_EFFORT@
# Apaga la conversación dormida tras 15 min sin uso para liberar memoria.
Environment=JARVIS_CHAT_IDLE_MS=@JARVIS_CHAT_IDLE_MS@

ExecStart=@JARVIS_NODE_BIN@ src/index.js

Restart=on-failure
RestartSec=5
# La Pi 3B tiene 905 MB: limitamos para que un descontrol no arrastre al sistema.
MemoryMax=256M

# Endurecimiento básico: Jarvis no necesita privilegios ni escribir fuera de casa.
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis

[Install]
WantedBy=multi-user.target
