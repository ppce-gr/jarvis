[Unit]
Description=Jarvis · Centro de Mando (interfaz web de ideas y orquestación)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- Ajusta estas tres líneas a tu usuario y rutas reales ---
User=jarvis
WorkingDirectory=/home/jarvis/jarvis/jarvis
Environment=HOME=/home/jarvis
# La memoria vive en un repositorio aparte, fuera del codigo.
Environment=JARVIS_BRAIN_DIR=/home/jarvis/jarvis/jarvis-vault

# El CLI dsh vive aquí tras 'npm install -g @deepseek-ai/dsh@<version fijada>'.
# Un `command -v dsh` en tu shell te da la ruta exacta.
Environment=JARVIS_DSH_BIN=/usr/local/bin/dsh
Environment=JARVIS_DSH_PROFILE=headless
Environment=JARVIS_PORT=3081
Environment=JARVIS_HOST=0.0.0.0
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# --- Chat conversacional (ACP, un proceso para todos los proyectos) ---
# Perfil aparte del de orquestación: el chat necesita un proceso vivo con
# memoria, la orquestación necesita uno que muera al terminar.
# ACP aporta cancelacion real, reanudacion de la memoria y streaming por deltas.
Environment=JARVIS_CHAT_PROTOCOL=acp
Environment=JARVIS_CHAT_PROFILE=acp
Environment=JARVIS_CHAT_PROVIDER=deepseek-official
Environment=JARVIS_CHAT_MODEL=deepseek-v4-flash
Environment=JARVIS_CHAT_EFFORT=high
# Apaga la conversación dormida tras 15 min sin uso para liberar memoria.
Environment=JARVIS_CHAT_IDLE_MS=900000

ExecStart=/usr/bin/node src/index.js

Restart=on-failure
RestartSec=5
# La Pi 3B tiene 905 MB: limitamos para que un descontrol no arrastre al sistema.
MemoryMax=256M

# Endurecimiento básico: Jarvis no necesita privilegios ni escribir fuera de casa.
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis

[Install]
WantedBy=multi-user.target
