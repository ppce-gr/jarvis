# Permite al usuario de Jarvis ejecutar SOLO el helper de permisos.
# El helper, a su vez, solo ejecuta peticiones que existan y que se hayan
# aprobado con el PIN (que no pasa por aquí: va por stdin).
#
# Se instala en /etc/sudoers.d/jarvis-permisos con permisos 0440, validado
# antes con `visudo -cf` (un fichero mal formado rompe sudo entero).
jarvis ALL=(root) NOPASSWD: /usr/local/sbin/jarvis-permiso
