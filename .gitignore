# Dependencias (el proyecto no tiene de runtime, pero por si acaso)
node_modules/
npm-debug.log*

# Configuración local del usuario. El modelo elegido vive con la memoria,
# no en el repositorio público; aquí sólo se versiona el ejemplo.
chat-config.json

# Credenciales y secretos: NUNCA
.env
.env.local
*.key
*.pem
id_rsa
id_ed25519
.dsh-home/
.git-credentials

# Estado local
*.tmp
/jarvis-core.log

# Estado local de la autoactualización (ancla y registro)
.update-state/
.update-request

# Configuración local del despliegue (la genera deploy/configurar.sh)
deploy/jarvis.conf

# La bandera que escribe el AGENTE para pedir la actualización. Va ignorada para
# que el árbol siga limpio: la barrera 1 aborta si hay cambios sin commitear.
.solicitar-actualizacion
